{
	"info": {
		"name": "Family Medical Management - AI",
		"description": "Collection để test các API AI của Family Medical Management",
		"schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
	},
	"item": [
		{
			"name": "Authentication",
			"item": [
				{
					"name": "Login",
					"event": [
						{
							"listen": "test",
							"script": {
								"exec": [
									"if (pm.response.code === 200) {",
									"    var jsonData = pm.response.json();",
									"    pm.environment.set(\"token\", jsonData.token);",
									"    console.log(\"Token đã được lưu:\", jsonData.token);",
									"}"
								],
								"type": "text/javascript"
							}
						}
					],
					"request": {
						"method": "POST",
						"header": [
							{
								"key": "Content-Type",
								"value": "application/json"
							}
						],
						"body": {
							"mode": "raw",
							"raw": "{\n    \"username\": \"your_username\",\n    \"password\": \"your_password\"\n}"
						},
						"url": {
							"raw": "{{baseUrl}}/api/auth/login",
							"host": ["{{baseUrl}}"],
							"path": ["api", "auth", "login"]
						}
					}
				}
			]
		},
		{
			"name": "AI Chat",
			"item": [
				{
					"name": "Chat AI (No RAG)",
					"request": {
						"method": "POST",
						"header": [
							{
								"key": "Content-Type",
								"value": "application/json"
							},
							{
								"key": "Authorization",
								"value": "Bearer {{token}}"
							}
						],
						"body": {
							"mode": "raw",
							"raw": "{\n    \"message\": \"Xin chào, bạn là ai?\",\n    \"useRAG\": false\n}"
						},
						"url": {
							"raw": "{{baseUrl}}/api/ai/chat",
							"host": ["{{baseUrl}}"],
							"path": ["api", "ai", "chat"]
						}
					}
				},
				{
					"name": "Chat AI (With RAG)",
					"request": {
						"method": "POST",
						"header": [
							{
								"key": "Content-Type",
								"value": "application/json"
							},
							{
								"key": "Authorization",
								"value": "Bearer {{token}}"
							}
						],
						"body": {
							"mode": "raw",
							"raw": "{\n    \"message\": \"Tóm tắt thông tin về bệnh tiểu đường trong tài liệu của tôi\",\n    \"useRAG\": true\n}"
						},
						"url": {
							"raw": "{{baseUrl}}/api/ai/chat",
							"host": ["{{baseUrl}}"],
							"path": ["api", "ai", "chat"]
						}
					}
				}
			]
		},
		{
			"name": "Documents",
			"item": [
				{
					"name": "Upload Document",
					"request": {
						"method": "POST",
						"header": [
							{
								"key": "Authorization",
								"value": "Bearer {{token}}"
							}
						],
						"body": {
							"mode": "formdata",
							"formdata": [
								{
									"key": "file",
									"type": "file",
									"src": []
								}
							]
						},
						"url": {
							"raw": "{{baseUrl}}/api/ai/documents/upload",
							"host": ["{{baseUrl}}"],
							"path": ["api", "ai", "documents", "upload"]
						}
					}
				},
				{
					"name": "Get Documents",
					"request": {
						"method": "GET",
						"header": [
							{
								"key": "Authorization",
								"value": "Bearer {{token}}"
							}
						],
						"url": {
							"raw": "{{baseUrl}}/api/ai/documents",
							"host": ["{{baseUrl}}"],
							"path": ["api", "ai", "documents"]
						}
					}
				},
				{
					"name": "Delete Document",
					"request": {
						"method": "DELETE",
						"header": [
							{
								"key": "Authorization",
								"value": "Bearer {{token}}"
							}
						],
						"url": {
							"raw": "{{baseUrl}}/api/ai/documents/1",
							"host": ["{{baseUrl}}"],
							"path": ["api", "ai", "documents", "1"]
						}
					}
				}
			]
		}
	],
	"variable": [
		{
			"key": "baseUrl",
			"value": "http://localhost:8081"
		},
		{
			"key": "token",
			"value": ""
		}
	]
}

